# Copier ce fichier vers .env. Ne jamais committer le fichier .env réel.

# L'application fonctionne sans fournisseur externe.
APP_ENV=development
RUN_ONLINE_EXPERIMENT=0
RUN_VISUAL_ENRICHMENT=0
# Rules are always active. Set to 1 to allow Gemini only for ambiguous mappings.
ENABLE_HYBRID_MAPPING=0
ENABLE_GEMINI_GENERATION=0

# API Google : laisser vide tant qu'aucun essai online n'est demandé.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_GENERATION_MODEL=gemini-2.5-flash

# Modèle open-weight déjà disponible localement.
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small
LOCAL_EMBEDDING_MODEL_PATH=

# Ollama local, uniquement si installé sur le poste développeur.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=
